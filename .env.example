# SyncForge — copy to .env and fill in

# ─────────────────── LLM providers (chain order) ───────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ─────────────────── Embedding (primary: Gemini Emb 2) ─────────────
# Reuses GEMINI_API_KEY by default. Set SYNCFORGE_EMBEDDER=siglip2 to use local.
SYNCFORGE_EMBEDDER=gemini

# ─────────────────── Stock sources ─────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
# YouTube uses yt-dlp, no key

# ─────────────────── TTS providers ─────────────────────────────────
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Edge-TTS needs no key

# ─────────────────── Generative fallback (optional) ────────────────
RUNWAY_API_KEY=
VEO_API_KEY=

# ─────────────────── Storage / cache tuning ────────────────────────
SYNCFORGE_CACHE_GB_MAX=20
SYNCFORGE_DOWNLOAD_DIR=storage/clips
SYNCFORGE_OUTPUT_DIR=storage/videos
